# ==============================================================================
# Git Ignore Configuration for OmniForge AI
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables & secrets (NEVER commit secrets!)
.env
.env.*
!.env.example
*.env

# SQLite and local databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# OmniForge operational output and runtime data
workspace/
artifacts/
data/
scratch/

# Testing and Code Quality
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.hypothesis/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IDEs and Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

